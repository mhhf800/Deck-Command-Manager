{
  "name": "Deck-Command-Manager",
  "version": "0.2",
  "description": "一个用于记录短文本的插件，主要用于记录一些容易忘记的启动项命令，支持新增，编辑，删除，复制。",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "_zip": "bestzip Deck-Command-Manager.zip dist main.py plugin.json assets backend py_modules package.json",
	"__zip": "mkdir -p Deck-Command-Manager && cp -r dist main.py plugin.json assets backend py_modules package.json Deck-Command-Manager/ && bestzip Deck-Command-Manager.zip Deck-Command-Manager && rm -rf Deck-Command-Manager",
    "zip": "node zip.js",
	"test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SteamDeckHomebrew/decky-plugin-template.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "plugin-template",
    "steam-deck",
    "deck"
  ],
  "author": "You <you@you.tld>",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/SteamDeckHomebrew/decky-plugin-template/issues"
  },
  "homepage": "https://github.com/SteamDeckHomebrew/decky-plugin-template#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "bestzip": "^4.0.3",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
